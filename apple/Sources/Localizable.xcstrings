    "Long-press a channel and tap ★ to add it to favorites.": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanalı uzun basıb ★ ilə favoritlərə əlavə edin."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Favorilere eklemek için bir kanala uzun basıp ★ seçin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halten Sie einen Sender gedrückt und tippen Sie auf ★, um ihn zu den Favoriten hinzuzufügen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsado un canal y toca ★ para añadirlo a favoritos."
          }
        }
