<?xml version="1.0" encoding="utf-8"?>
<!--
  MSIX manifest for the Microsoft Store.
  Tokens ($...$) are filled in by build-msix.ps1. For Store submissions, IDENTITY_NAME,
  PUBLISHER and PUBLISHER_DISPLAY_NAME must be the exact values shown in Partner Center under
  "Product management → Product identity".
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="$IDENTITY_NAME$"
    Publisher="$PUBLISHER$"
    Version="$VERSION$"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>AENV IPTV</DisplayName>
    <PublisherDisplayName>$PUBLISHER_DISPLAY_NAME$</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>IPTV player for M3U, XSPF and Xtream Codes playlists. Player only — no content included.</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-US" />
    <Resource Language="az-Latn-AZ" />
    <Resource Language="tr-TR" />
    <Resource Language="de-DE" />
    <Resource Language="es-ES" />
  </Resources>

  <Applications>
    <Application Id="AenvIPTV" Executable="AenvIPTV.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="AENV IPTV"
        Description="IPTV player for M3U, XSPF and Xtream Codes playlists"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile
          ShortName="AENV IPTV"
          Wide310x150Logo="Assets\Wide310x150Logo.png"
          Square71x71Logo="Assets\SmallTile.png"
          Square310x310Logo="Assets\LargeTile.png">
          <uap:ShowNameOnTiles>
            <uap:ShowOn Tile="square150x150Logo" />
            <uap:ShowOn Tile="wide310x150Logo" />
            <uap:ShowOn Tile="square310x310Logo" />
          </uap:ShowNameOnTiles>
        </uap:DefaultTile>
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#1D4ED8" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <!-- Streams and playlists from the internet -->
    <Capability Name="internetClient" />
    <!-- IPTV servers on the home network (e.g. TVHeadend, Plex) -->
    <Capability Name="privateNetworkClientServer" />
    <!-- Required for packaged Win32 desktop apps -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
