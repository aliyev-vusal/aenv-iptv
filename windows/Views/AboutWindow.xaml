<Window x:Class="Aenv.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Aenv"
        Icon="/Assets/AenvIPTV.ico"
        Title="{l:T about}" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource Panel}">
    <StackPanel Margin="28">
        <StackPanel Orientation="Horizontal">
            <Image Source="/Assets/AenvIPTV.ico" Width="56" Height="56"/>
            <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="AENV IPTV" FontSize="22" FontWeight="Bold"/>
                <TextBlock x:Name="VersionText" Foreground="{StaticResource Muted}" Margin="0,2,0,0"/>
            </StackPanel>
        </StackPanel>

        <TextBlock Text="{l:T about_disclaimer}" TextWrapping="Wrap" Margin="0,20,0,0" LineHeight="20"/>
        <TextBlock Text="© 2026 Vusal Aliyev" Foreground="{StaticResource Muted}" Margin="0,16,0,0"/>

        <WrapPanel Margin="0,20,0,0">
            <Button Style="{StaticResource FlatButton}" Content="{l:T privacy_policy}" Margin="0,0,8,8" Click="Privacy_Click"/>
            <Button Style="{StaticResource FlatButton}" Content="{l:T license}" Margin="0,0,8,8" Click="License_Click"/>
            <Button Style="{StaticResource FlatButton}" Content="{l:T third_party}" Margin="0,0,8,8" Click="Notices_Click"/>
        </WrapPanel>

        <Button Style="{StaticResource AccentButton}" Content="{l:T close}" HorizontalAlignment="Right"
                Margin="0,12,0,0" IsCancel="True" IsDefault="True"/>
    </StackPanel>
</Window>
