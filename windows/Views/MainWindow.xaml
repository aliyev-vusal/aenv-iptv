<Window x:Class="Aenv.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Aenv"
        Icon="/Assets/AenvIPTV.ico"
        xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
        Title="AENV IPTV" Height="780" Width="1280" MinWidth="900" MinHeight="560"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <ItemsPanelTemplate x:Key="GridPanel">
            <vwp:VirtualizingWrapPanel/>
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="ListPanel">
            <VirtualizingStackPanel/>
        </ItemsPanelTemplate>

        <!-- Tile (channel logo / movie poster) -->
        <DataTemplate x:Key="TileTemplate">
            <Border Width="176" Margin="6" Background="{StaticResource Card}" CornerRadius="10" Padding="8">
                <StackPanel>
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Height" Value="100"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLive}" Value="False">
                                        <Setter Property="Height" Value="236"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Border Background="#11141A" CornerRadius="6"/>
                        <TextBlock Text="&#xE7F4;" FontFamily="{StaticResource Icons}" FontSize="28"
                                   Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Image Source="{Binding Logo, TargetNullValue={x:Null}}" Margin="6"
                               RenderOptions.BitmapScalingMode="HighQuality" Stretch="Uniform"/>
                        <TextBlock Text="&#xE735;" FontFamily="{StaticResource Icons}" Foreground="Gold"
                                   HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6"
                                   Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVis}}"/>
                    </Grid>
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="0,8,0,0" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
                    <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="1" Height="3" Margin="0,5,0,0"
                                 Foreground="{StaticResource Accent}" Background="#2E3440" BorderThickness="0"
                                 Visibility="{Binding HasProgress, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- List row -->
        <DataTemplate x:Key="RowTemplate">
            <Border Margin="0,2" Padding="10,8" Background="{StaticResource Card}" CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="72"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="#11141A" CornerRadius="6" Height="42">
                        <Image Source="{Binding Logo, TargetNullValue={x:Null}}" Margin="4" Stretch="Uniform"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="&#xE735;" FontFamily="{StaticResource Icons}" Foreground="Gold"
                               VerticalAlignment="Center" Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVis}}"/>
                </Grid>
            </Border>
        </DataTemplate>

        <Style x:Key="ContentItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <EventSetter Event="MouseDoubleClick" Handler="Item_DoubleClick"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" BorderThickness="2" BorderBrush="Transparent" CornerRadius="12">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#3A4150"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="8" Padding="10,8" Margin="0,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Card}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GroupChip" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="{StaticResource Card}" CornerRadius="14" Padding="12,5" Margin="0,0,6,0">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== Sidebar ===== -->
        <DockPanel Background="{StaticResource Panel}">
            <TextBlock DockPanel.Dock="Top" Text="AENV IPTV" FontSize="26" FontWeight="Bold" Margin="18,18,18,12"/>
            <StackPanel DockPanel.Dock="Bottom" Margin="12">
                <DockPanel Margin="0,0,0,10">
                    <TextBlock Text="&#xE774;" FontFamily="{StaticResource Icons}" Foreground="{StaticResource Muted}"
                               VerticalAlignment="Center" Margin="2,0,8,0" ToolTip="{l:T language}"/>
                    <ComboBox x:Name="LanguageBox" DisplayMemberPath="Name" AutomationProperties.Name="{l:T language}" SelectionChanged="Language_Changed"/>
                </DockPanel>
                <Button Style="{StaticResource AccentButton}" Click="AddPlaylist_Click" Margin="0,0,0,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="{StaticResource Icons}" Margin="0,2,8,0"/>
                        <TextBlock Text="{l:T add_playlist}"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource FlatButton}" Click="About_Click" Margin="0,0,0,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE946;" FontFamily="{StaticResource Icons}" Margin="0,2,8,0"/>
                        <TextBlock Text="{l:T about}"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource FlatButton}" Click="RefreshAll_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" FontFamily="{StaticResource Icons}" Margin="0,2,8,0"/>
                        <TextBlock Text="{l:T refresh_all}"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <ListBox x:Name="Sidebar" Background="Transparent" BorderThickness="0" Margin="8,0"
                     ItemContainerStyle="{StaticResource SidebarItem}" SelectionChanged="Sidebar_SelectionChanged"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding Badge}" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{l:T refresh}" Click="RefreshPlaylist_Click"/>
                        <MenuItem Header="{l:T edit}" Click="EditPlaylist_Click"/>
                        <MenuItem Header="{l:T delete}" Click="DeletePlaylist_Click"/>
                    </ContextMenu>
                </ListBox.ContextMenu>
            </ListBox>
        </DockPanel>

        <!-- ===== Main area ===== -->
        <Grid Grid.Column="1" Margin="20,16,20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TitleText" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,20,0"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton x:Name="KindLive" Style="{StaticResource ChipToggle}" GroupName="kind" Content="{l:T live}" IsChecked="True" Checked="Kind_Checked"/>
                    <RadioButton x:Name="KindMovie" Style="{StaticResource ChipToggle}" GroupName="kind" Content="{l:T movies}" Checked="Kind_Checked"/>
                    <RadioButton x:Name="KindSeries" Style="{StaticResource ChipToggle}" GroupName="kind" Content="{l:T series}" Checked="Kind_Checked"/>
                </StackPanel>
                <Grid Grid.Column="2" Width="280" Margin="0,0,10,0">
                    <TextBox x:Name="SearchBox" Style="{StaticResource DarkTextBox}" AutomationProperties.Name="{l:T search}" Padding="30,6,8,6" TextChanged="Search_TextChanged"/>
                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource Icons}" Foreground="{StaticResource Muted}"
                               Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    <TextBlock x:Name="SearchPlaceholder" Text="{l:T search}" Foreground="{StaticResource Muted}"
                               Margin="32,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                </Grid>
                <Button x:Name="ViewToggle" Grid.Column="3" Style="{StaticResource FlatButton}" Click="ViewToggle_Click"
                        ToolTip="{l:T view_toggle}" AutomationProperties.Name="{l:T view_toggle}">
                    <TextBlock x:Name="ViewToggleIcon" Text="&#xE8FD;" FontFamily="{StaticResource Icons}"/>
                </Button>
            </Grid>

            <ListBox x:Name="GroupList" Grid.Row="1" Margin="0,14,0,10" Background="Transparent" BorderThickness="0"
                     ItemContainerStyle="{StaticResource GroupChip}" SelectionChanged="Group_SelectionChanged"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>

            <ListBox x:Name="ContentList" Grid.Row="2" Background="Transparent" BorderThickness="0"
                     ItemContainerStyle="{StaticResource ContentItem}"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" KeyDown="ContentList_KeyDown">
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{l:T play}" Click="PlayMenu_Click"/>
                        <MenuItem Header="{l:T fav_toggle}" Click="ToggleFav_Click"/>
                        <MenuItem Header="{l:T copy_link}" Click="CopyUrl_Click"/>
                    </ContextMenu>
                </ListBox.ContextMenu>
            </ListBox>

            <StackPanel x:Name="EmptyState" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock Text="&#xE7F4;" FontFamily="{StaticResource Icons}" FontSize="48" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/>
                <TextBlock x:Name="EmptyText" Foreground="{StaticResource Muted}" FontSize="15" Margin="0,12,0,0"
                           TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420"/>
            </StackPanel>
        </Grid>

        <!-- Series detail, shown over the content area -->
        <Border x:Name="SeriesHost" Grid.Column="1" Background="{StaticResource Bg}" Padding="20,16,20,0" Visibility="Collapsed"/>

        <!-- Embedded player, covers the whole window -->
        <Border x:Name="PlayerHost" Grid.ColumnSpan="2" Background="Black" Visibility="Collapsed"/>
    </Grid>
</Window>
