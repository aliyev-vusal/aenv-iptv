<UserControl x:Class="Aenv.Views.SeriesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Aenv"
             Background="{StaticResource Bg}" Focusable="True" PreviewKeyDown="View_KeyDown">
    <Grid Margin="0,4,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Button Style="{StaticResource FlatButton}" HorizontalAlignment="Left" Margin="0,0,0,16" Click="Back_Click"
                ToolTip="{l:T tip_back}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE72B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,2,8,0"/>
                <TextBlock Text="{l:T back}"/>
            </StackPanel>
        </Button>

        <StackPanel Grid.Row="1" Orientation="Horizontal">
            <Border Width="120" Height="180" CornerRadius="10" Background="#11141A" ClipToBounds="True">
                <Image x:Name="Poster" Stretch="UniformToFill"/>
            </Border>
            <StackPanel Margin="18,0,0,0" VerticalAlignment="Center" MaxWidth="500">
                <TextBlock x:Name="NameText" FontSize="22" FontWeight="Bold" TextWrapping="Wrap"/>
                <TextBlock x:Name="GroupText" Foreground="{StaticResource Muted}" Margin="0,4,0,12"/>
                <Button x:Name="FavButton" Style="{StaticResource FlatButton}" HorizontalAlignment="Left" Click="Fav_Click"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,18,0,8">
            <TextBlock Text="{l:T season}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="SeasonBox" Width="140" SelectionChanged="Season_Changed"/>
            <TextBlock x:Name="StatusText" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="16,0,0,0"/>
        </StackPanel>

        <ListBox x:Name="EpisodeList" Grid.Row="3" Background="Transparent" BorderThickness="0"
                 Foreground="{StaticResource Text}" MouseDoubleClick="Episode_DoubleClick" KeyDown="Episode_KeyDown">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="4,8">
                        <TextBlock Text="&#xE768;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,2,12,0"/>
                        <TextBlock Text="{Binding Display}" FontSize="14"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
