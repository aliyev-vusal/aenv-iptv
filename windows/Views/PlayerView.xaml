<UserControl x:Class="Aenv.Views.PlayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Aenv"
             xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
             Background="Black" Focusable="True" PreviewKeyDown="Player_KeyDown">

    <UserControl.Resources>
        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
        </Style>
    </UserControl.Resources>

    <vlc:VideoView x:Name="Video">
        <!-- VideoView content is rendered in a separate transparent window above the video -->
        <Grid x:Name="Overlay" Background="#01000000" Focusable="True"
              MouseMove="Overlay_MouseMove" MouseLeftButtonDown="Overlay_MouseDown" PreviewKeyDown="Player_KeyDown">

            <!-- ===== Top: channel and EPG ===== -->
            <Border x:Name="TopBar" VerticalAlignment="Top" Padding="24,20,24,40">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#E6000000" Offset="0"/>
                        <GradientStop Color="#00000000" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BackButton" Style="{StaticResource IconButton}" Content="&#xE72B;" FontSize="20"
                            VerticalAlignment="Center" Margin="0,0,12,0" ToolTip="{l:T tip_back}" AutomationProperties.Name="{l:T tip_back}" Click="Back_Click"/>
                    <Border Grid.Column="1" Width="104" Height="64" CornerRadius="8" Background="#22FFFFFF">
                        <Image x:Name="LogoImage" Margin="6" Stretch="Uniform"/>
                    </Border>
                    <StackPanel Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="ChannelName" FontSize="22" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="NowText" FontSize="14" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                        <ProgressBar x:Name="NowProgress" Maximum="1" Height="4" Width="340" HorizontalAlignment="Left" Margin="0,6,0,0"
                                     Foreground="{StaticResource Accent}" Background="#44FFFFFF" BorderThickness="0"/>
                        <TextBlock x:Name="NextText" FontSize="12" Foreground="#B3FFFFFF" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <TextBlock x:Name="ClockText" Grid.Column="3" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Top"/>
                </Grid>
            </Border>

            <!-- ===== Status (buffering / error) ===== -->
            <TextBlock x:Name="StatusText" HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="18" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="600" Visibility="Collapsed"/>

            <!-- ===== Bottom: controls ===== -->
            <Border x:Name="BottomBar" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="24,0,24,28"
                    Padding="16,10" CornerRadius="16" Background="#D91A1D24" MinWidth="620">
                <StackPanel>
                    <Grid x:Name="SeekRow" Margin="4,0,4,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TimeText" Text="0:00" VerticalAlignment="Center" FontSize="12" Width="56"/>
                        <Slider x:Name="SeekSlider" Grid.Column="1" Maximum="1" VerticalAlignment="Center" Focusable="False"
                                IsMoveToPointEnabled="True"
                                PreviewMouseDown="Seek_MouseDown" PreviewMouseUp="Seek_MouseUp"/>
                        <TextBlock x:Name="DurationText" Grid.Column="2" Text="0:00" VerticalAlignment="Center" FontSize="12"
                                   Width="56" TextAlignment="Right"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Style="{StaticResource IconButton}" Content="&#xE70E;" ToolTip="{l:T tip_prev}" AutomationProperties.Name="{l:T tip_prev}" Click="Prev_Click"/>
                        <Button x:Name="PlayButton" Style="{StaticResource IconButton}" Content="&#xE769;" ToolTip="{l:T tip_play}" AutomationProperties.Name="{l:T tip_play}" Click="PlayPause_Click"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE70D;" ToolTip="{l:T tip_next}" AutomationProperties.Name="{l:T tip_next}" Click="Next_Click"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE8FD;" ToolTip="{l:T tip_list}" AutomationProperties.Name="{l:T tip_list}" Click="List_Click"/>
                        <Button x:Name="FavButton" Style="{StaticResource IconButton}" Content="&#xE734;" ToolTip="{l:T tip_fav}" AutomationProperties.Name="{l:T tip_fav}" Click="Fav_Click"/>
                        <Rectangle Width="1" Fill="#33FFFFFF" Margin="10,8"/>
                        <Button x:Name="MuteButton" Style="{StaticResource IconButton}" Content="&#xE767;" ToolTip="{l:T tip_mute}" AutomationProperties.Name="{l:T tip_mute}" Click="Mute_Click"/>
                        <Slider x:Name="VolumeSlider" Width="110" Maximum="100" Value="80" VerticalAlignment="Center"
                                Focusable="False" IsMoveToPointEnabled="True" ValueChanged="Volume_Changed"/>
                        <Rectangle Width="1" Fill="#33FFFFFF" Margin="10,8"/>
                        <Button x:Name="FullButton" Style="{StaticResource IconButton}" Content="&#xE740;" ToolTip="{l:T tip_full}" AutomationProperties.Name="{l:T tip_full}" Click="Fullscreen_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ===== Left: channel list ===== -->
            <Border x:Name="ListPanel" HorizontalAlignment="Left" Width="400" Background="#F014171D" Visibility="Collapsed">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{l:T channels}" FontSize="18" FontWeight="SemiBold" Margin="18,18,18,10"/>
                    <ListBox x:Name="QueueList" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Text}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                             MouseDoubleClick="Queue_DoubleClick" KeyDown="Queue_KeyDown">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="6,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="56"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Image Source="{Binding Logo, TargetNullValue={x:Null}}" Height="32" Stretch="Uniform"/>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
    </vlc:VideoView>
</UserControl>
